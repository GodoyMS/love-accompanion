{
  "name": "love-accompanion",
  "version": "1.0.0",
  "description": "WhatsApp companion that replies in your voice, with a one-click kill switch.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "tsc -p tsconfig.json && vite build --config web/vite.config.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "test": "tsx --test test/*.test.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GodoyMS/love-accompanion.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/GodoyMS/love-accompanion/issues"
  },
  "homepage": "https://github.com/GodoyMS/love-accompanion#readme",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.14.0",
    "@fastify/cookie": "^11.1.5",
    "@fastify/multipart": "^10.1.9",
    "@fastify/static": "^10.1.12",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "fastify": "^5.12.8",
    "fflate": "^0.8.3",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.7",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.1",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  }
}