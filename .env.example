# Postgres (Railway Postgres or Supabase connection string)
DATABASE_URL=postgres://user:pass@host:5432/db
# Password for the control panel
ADMIN_PASSWORD=change-me
ANTHROPIC_API_KEY=sk-ant-...
# Her WhatsApp number, international format, digits only (Peru: 51 + 9 digits)
PARTNER_NUMBER=51987654321

# Optional
# SESSION_SECRET=random-long-string
# CLAUDE_MODEL=claude-sonnet-5-5
# CLAUDE_FAST_MODEL=claude-haiku-5-5
# TZ_NAME=America/Lima

# Voice notes → text (set ONE; ElevenLabs wins if both)
# ELEVENLABS_API_KEY=
# OPENAI_API_KEY=
# STT_MODEL=scribe_v2   # or gpt-transcribe for OpenAI

# Answer her voice notes with a voice note in your voice (needs ELEVENLABS_API_KEY)
# ELEVENLABS_VOICE_ID=
# TTS_MODEL=eleven_multilingual_v2
